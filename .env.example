# Copy this file to .env and add your own credentials.
# Never commit .env or paste real credentials into source code.

# Required for live cultural intelligence from Qloo.
QLOO_API_KEY=
QLOO_API_URL=https://api.qloo.com/v2/insights

# Required for LLM scenario generation and the AI report layer.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# HTTP timeout per provider request, in seconds.
PANOPTICON_REQUEST_TIMEOUT=20
